      }
    },
    "Found targets leave the board, so their tiles can't spell other words. Finding the last target ends the board." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los objetivos encontrados salen del tablero, así que sus fichas no sirven para otras palabras. Encontrar el último objetivo termina el tablero."
